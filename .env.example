# docs/README.md §3.2 — 로컬 개발용 예시. `cp .env.example .env` 후 사용.
# 키 이름은 TDD §10 + PRD 부록 B가 SSOT. 임의 변경 금지.

# Common
APP_ENV=local
LOG_LEVEL=DEBUG
TZ=Asia/Seoul

# Offline (로컬 개발도 동일 유지 — 외부 다운로드 경로 조기 검출)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1
HF_HOME=/models/huggingface

# Infra
REDIS_URL=redis://localhost:6379/0
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag-dev-only
POSTGRES_DB=rag
QDRANT_URL=http://localhost:6333

# 내부 서비스 URL (로컬)
EMBEDDING_API_URL=http://localhost:8004
RERANKER_API_URL=http://localhost:8005
VLLM_API_URL=http://localhost:8010/v1
BRIDGE_INTERNAL_URL=http://localhost:8001

# Mattermost Bridge
MATTERMOST_BASE_URL=https://mattermost.internal.example
MATTERMOST_OUTGOING_TOKEN_SECRET_FILE=./secrets/mattermost/outgoing-token
BRIDGE_ALLOWED_SOURCE_CIDRS=127.0.0.1/32,10.0.0.0/8
BRIDGE_BOT_USERNAME=RAG Assistant
BRIDGE_BINDING_CACHE_TTL_SECONDS=60
MATTERMOST_DEFAULT_TRIGGER_WORD=!rag
MATTERMOST_MAX_POST_CHARS=12000

# Rate Limit
RATE_LIMIT_PER_USER_PER_MIN=10
RATE_LIMIT_PER_CHANNEL_PER_MIN=30
RATE_LIMIT_FEEDBACK_PER_USER_PER_MIN=20

# Feedback (v1.1)
FEEDBACK_ENABLED=true
FEEDBACK_SIGNING_KEY_FILE=./secrets/rag/feedback-signing-key

# Retrieval / Model
VECTOR_TOP_K=30
RERANK_TOP_N=8
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_CONTEXT_TOKENS=8192
MAX_OUTPUT_TOKENS=1024
SAFETY_MARGIN_TOKENS=256
SIMILARITY_THRESHOLD=0.0
RERANK_SCORE_THRESHOLD=0.0
CHAT_MAX_CONCURRENCY=15
LLM_MODEL_PATH=/models/llm/main
LLM_SERVED_MODEL_NAME=internal-rag-llm
EMBEDDING_MODEL_PATH=/models/embedding/bge-m3
RERANKER_MODEL_PATH=/models/reranker/bge-reranker-v2-m3
TOKENIZER_PATH=/models/llm/main

# 로컬 mock (모델 미배치 시) — 프로덕션에서는 미설정
EMBEDDING_MOCK=1
RERANKER_MOCK=1
