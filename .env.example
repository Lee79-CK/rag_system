# docs/README.md §3.2 — 로컬 개발용 예시. `cp .env.example .env` 후 사용.
# 키 이름은 TDD §10 + PRD 부록 B가 SSOT. 임의 변경 금지.

# Common
APP_ENV=local
LOG_LEVEL=DEBUG
TZ=Asia/Seoul

# Offline (로컬 개발도 동일 유지 — 외부 다운로드 경로 조기 검출)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1
HF_HOME=/models/huggingface

# Infra
REDIS_URL=redis://localhost:6379/0
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag-dev-only
POSTGRES_DB=rag
QDRANT_URL=http://localhost:6333

# 내부 서비스 URL (로컬)
EMBEDDING_API_URL=http://localhost:8004
RERANKER_API_URL=http://localhost:8005
VLLM_API_URL=http://localhost:8010/v1

# Web Chat — chat-gateway (aiops_chatbot UI 이식, TDD §7.1)
CHAT_WORKSPACE_SLUG=rag                  # prehash salt 구성요소 — chat-web NEXT_PUBLIC_WORKSPACE_SLUG 와 동일
CHAT_WORKSPACE_NAME=RAG Assistant
CHAT_DEFAULT_TRIGGER_WORD=!rag
CHAT_MAX_POST_CHARS=12000
CHAT_CORS_ORIGINS=http://localhost:3000  # dev 교차 출처(WS). 운영(Ingress 동일 출처)은 비움
JWT_SECRET_FILE=./secrets/rag/jwt-secret
PASSWORD_PEPPER_FILE=./secrets/rag/password-pepper   # chat-gateway · admin-api 공유
CHAT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
COOKIE_SECURE=false                      # 로컬 HTTP 전용. 운영 true (HTTPS)
LOGIN_MAX_CLOCK_SKEW_SECONDS=300
RATE_LIMIT_LOGIN_PER_MIN=10

# chat-web (Next.js) — apps/chat-web/.env.local 에 둔다 (NEXT_PUBLIC_* 는 build 시 고정)
#   CHAT_GATEWAY_URL=http://localhost:8001      # dev rewrite 대상 (/api)
#   NEXT_PUBLIC_WS_URL=http://localhost:8001    # dev: gateway 직접 / 운영: 비움(same-origin)
#   NEXT_PUBLIC_WORKSPACE_SLUG=rag

# Rate Limit
RATE_LIMIT_PER_USER_PER_MIN=10
RATE_LIMIT_PER_CHANNEL_PER_MIN=30
RATE_LIMIT_FEEDBACK_PER_USER_PER_MIN=20

# Feedback (v1.1)
FEEDBACK_ENABLED=true
FEEDBACK_SIGNING_KEY_FILE=./secrets/rag/feedback-signing-key

# admin-api
DOCUMENT_STORAGE_PATH=./data/documents
MAX_UPLOAD_BYTES=104857600
# none: index_jobs 행만 생성(CLI 로 직접 실행) · k8s: kube-apiserver 로 parser-indexer Job 생성 (클러스터 내부 전용)
INDEX_JOB_TRIGGER=none
INDEX_JOB_NAMESPACE=rag-ingestion
INDEX_JOB_TEMPLATE_CONFIGMAP=parser-indexer-job-template

# Timeouts / LLM
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.2
# thinking 모델(Qwen3.x) 추론 on/off — vLLM chat_template_kwargs.enable_thinking. RAG 는 기본 false
LLM_ENABLE_THINKING=false
HTTP_CONNECT_TIMEOUT=3
HTTP_READ_TIMEOUT=30
QDRANT_COLLECTION=rag_chunks_v1

# Retrieval / Model
VECTOR_TOP_K=30
RERANK_TOP_N=8
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_CONTEXT_TOKENS=8192
MAX_OUTPUT_TOKENS=1024
SAFETY_MARGIN_TOKENS=256
SIMILARITY_THRESHOLD=0.0
RERANK_SCORE_THRESHOLD=0.0
CHAT_MAX_CONCURRENCY=15
LLM_MODEL_PATH=/models/llm/main
LLM_SERVED_MODEL_NAME=internal-rag-llm
EMBEDDING_MODEL_PATH=/models/embedding/bge-m3
RERANKER_MODEL_PATH=/models/reranker/bge-reranker-v2-m3
TOKENIZER_PATH=/models/llm/main
EMBEDDING_MAX_BATCH=64
# 임베딩 입력 최대 토큰 (FlagEmbedding 기본 512 절단 방지) / 비대칭 모델 질의 접두어 (bge-m3·KURE-v1 은 빈 값)
EMBEDDING_MAX_LENGTH=2048
EMBEDDING_QUERY_PREFIX=
RERANK_MAX_CANDIDATES=50
RERANKER_MAX_LENGTH=1024
MIN_CHUNK_TOKENS=50
# 청커 문자→토큰 근사. 영문 3.3 / 한글 문서 위주면 1.9 (bge-m3 토크나이저 실측 1.87)
CHARS_PER_TOKEN=3.3
# PDF 텍스트 엔진: auto(PyMuPDF + 순서 깨진 페이지만 pdfplumber) | pymupdf | pdfplumber
PDF_TEXT_ENGINE=auto
OCR_ENABLED=0

# 평가 runner (tools/evaluation) — rag-api 를 직접 호출한다 (LLM-judge 없음)
RAG_API_URL=http://localhost:8002

# 로컬 mock (모델 미배치 시) — 프로덕션에서는 미설정
EMBEDDING_MOCK=1
RERANKER_MOCK=1
