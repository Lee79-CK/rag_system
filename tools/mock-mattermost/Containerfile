# syntax=docker/dockerfile:1
# mock-mattermost — 랩 전용 Incoming Webhook 수신 mock. 빌드 컨텍스트는 리포 루트:
#   docker build -f tools/mock-mattermost/Containerfile -t $REG/rag/mock-mattermost:$TAG .
ARG PYTHON_IMAGE=python:3.12-slim
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.5
FROM ${UV_IMAGE} AS uv
FROM ${PYTHON_IMAGE} AS builder
COPY --from=uv /uv /uvx /bin/
ARG UV_INDEX_URL=""
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never UV_ONLY_BINARY=":all:"
WORKDIR /app
COPY . .
RUN --mount=type=cache,target=/root/.cache/uv \
    if [ -n "$UV_INDEX_URL" ]; then export UV_INDEX_URL; fi; \
    uv sync --frozen --no-dev --package mock-mattermost
FROM ${PYTHON_IMAGE}
RUN groupadd -g 10001 app && useradd -u 10001 -g 10001 -M -d /app -s /usr/sbin/nologin app
WORKDIR /app
COPY --from=builder --chown=10001:10001 /app /app
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1
USER 10001
EXPOSE 9099
CMD ["uvicorn", "mock_mattermost.server:app", "--host", "0.0.0.0", "--port", "9099"]
