# syntax=docker/dockerfile:1
# admin-web — React/Vite 정적 빌드 + nginx(비루트, :8080). 빌드 컨텍스트는 apps/admin-web:
#   docker build -f apps/admin-web/Containerfile -t $REG/rag/admin-web:$TAG apps/admin-web
# API 는 Ingress 가 /api → admin-api 로 프록시하므로 nginx 는 정적 파일 + SPA fallback 만 담당한다.
# 폐쇄망: NODE_IMAGE / NGINX_IMAGE 를 내부 Harbor digest 로 교체, npm registry 는 --build-arg NPM_REGISTRY.
ARG NODE_IMAGE=node:20-alpine
ARG NGINX_IMAGE=nginx:1.27-alpine

FROM ${NODE_IMAGE} AS build
ARG NPM_REGISTRY=""
WORKDIR /src
COPY package.json package-lock.json ./
RUN if [ -n "$NPM_REGISTRY" ]; then npm config set registry "$NPM_REGISTRY"; fi && npm ci
COPY . .
RUN npm run build          # tsc --noEmit && vite build → dist/

FROM ${NGINX_IMAGE}
# 비루트(10001) + readOnlyRootFilesystem 에서 동작: pid/temp 는 /tmp(emptyDir) 사용 (nginx.conf)
COPY nginx.conf /etc/nginx/nginx.conf
COPY --from=build /src/dist /usr/share/nginx/html
RUN chown -R 10001:10001 /usr/share/nginx/html
USER 10001
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
