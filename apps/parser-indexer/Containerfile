# syntax=docker/dockerfile:1
# parser-indexer — K8s Job 이미지 (ADR-008). 빌드 컨텍스트는 리포 루트:
#   docker build -f apps/parser-indexer/Containerfile -t $REG/rag/parser-indexer:$TAG .
# 실행: python -m ingestion.main --index-job-id <uuid>   (chart: templates/parser-indexer-job.yaml)
ARG PYTHON_IMAGE=python:3.12-slim
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.5

FROM ${UV_IMAGE} AS uv

# ---------- manifests: 의존성 선언(pyproject.toml · uv.lock)만 추린다 ----------
# 소스가 바뀌어도 이 결과가 같으면 아래 "1) 의존성" 레이어를 캐시에서 그대로 재사용한다(BuildKit COPY 캐시 키 =
# 파일 내용). venv 와 소스를 한 레이어로 묶으면 커밋마다 수 GB 레이어가 새로 생겨 빌드 PC 디스크가 찬다(가이드 §8).
FROM ${PYTHON_IMAGE} AS manifests
WORKDIR /src
COPY . .
RUN mkdir /out && find . \( -name pyproject.toml -o -name uv.lock \) -exec cp --parents {} /out \;

# ---------- runtime ----------
FROM ${PYTHON_IMAGE}
ARG UV_INDEX_URL=""
ENV UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_ONLY_BINARY=":all:"
RUN groupadd -g 10001 app && useradd -u 10001 -g 10001 -M -d /app -s /usr/sbin/nologin app
WORKDIR /app
# --frozen: uv.lock 그대로 (NFR-MAINT-004) · --no-dev · 이 서비스 패키지만. uv 바이너리는 빌드 중에만 마운트(이미지에 남기지 않음).
# 파일은 root 소유·읽기 전용으로 둔다 — 컨테이너는 uid 10001 + readOnlyRootFilesystem 이라 /app 에 쓰지 않는다.
# 1) 서드파티 의존성 — uv.lock 이 같으면 캐시 재사용 (이미지 용량의 대부분)
COPY --from=manifests /out/ ./
RUN --mount=from=uv,source=/uv,target=/bin/uv --mount=type=cache,target=/root/.cache/uv \
    if [ -n "$UV_INDEX_URL" ]; then export UV_INDEX_URL; fi; \
    UV_COMPILE_BYTECODE=1 uv sync --frozen --no-dev --no-install-workspace --package parser-indexer
# 2) 소스 + workspace 멤버(editable) — 커밋마다 바뀌는 작은 레이어. 여기서는 바이트코드를 다시 컴파일하지 않는다
#    (1)의 .pyc 를 다시 쓰면 그 파일들이 이 레이어로 복사되어 레이어가 다시 커진다)
COPY . .
RUN --mount=from=uv,source=/uv,target=/bin/uv --mount=type=cache,target=/root/.cache/uv \
    if [ -n "$UV_INDEX_URL" ]; then export UV_INDEX_URL; fi; \
    uv sync --frozen --no-dev --package parser-indexer
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_DATASETS_OFFLINE=1 HF_HOME=/models/huggingface
USER 10001
# 기본은 도움말 — Job 이 command 로 --index-job-id 를 넘긴다
ENTRYPOINT ["python", "-m", "ingestion.main"]
CMD ["--help"]
