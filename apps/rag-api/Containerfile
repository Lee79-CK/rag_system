# syntax=docker/dockerfile:1
# rag-api — 빌드 컨텍스트는 **리포 루트** (uv workspace 해석):
#   docker build -f apps/rag-api/Containerfile -t $REG/rag/rag-api:$TAG .
# 폐쇄망: 베이스 이미지는 내부 Harbor + digest 고정(TDD §3.4). 예)
#   --build-arg PYTHON_IMAGE=harbor.internal/library/python:3.12-slim@sha256:...
#   --build-arg UV_IMAGE=harbor.internal/astral/uv:0.5@sha256:...
#   --build-arg UV_INDEX_URL=https://pypi.internal/simple   (cp312 바이너리 휠만 — sdist 빌드 금지)
ARG PYTHON_IMAGE=python:3.12-slim
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.5

FROM ${UV_IMAGE} AS uv

# ---------- builder ----------
FROM ${PYTHON_IMAGE} AS builder
COPY --from=uv /uv /uvx /bin/
ARG UV_INDEX_URL=""
ARG UV_EXTRA=""
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_NO_BINARY="" \
    UV_ONLY_BINARY=":all:"
WORKDIR /app
COPY . .
# --frozen: uv.lock 그대로 (NFR-MAINT-004) · --no-dev · 이 서비스 패키지만 설치 (workspace 멤버는 editable)
RUN --mount=type=cache,target=/root/.cache/uv \
    if [ -n "$UV_INDEX_URL" ]; then export UV_INDEX_URL; fi; \
    uv sync --frozen --no-dev --package rag-api ${UV_EXTRA:+--extra $UV_EXTRA}

# ---------- runtime ----------
FROM ${PYTHON_IMAGE}
RUN groupadd -g 10001 app && useradd -u 10001 -g 10001 -M -d /app -s /usr/sbin/nologin app
WORKDIR /app
COPY --from=builder --chown=10001:10001 /app /app
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_DATASETS_OFFLINE=1 HF_HOME=/models/huggingface
USER 10001
EXPOSE 8002
# chart 의 appServices.<svc>.command 와 동일 (values.yaml). readOnlyRootFilesystem 대응: 쓰기는 /tmp 만.
CMD ["uvicorn", "rag.main:app", "--host", "0.0.0.0", "--port", "8002"]
